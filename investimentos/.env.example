# Banco local (SQLite por padrao)
INV_DATABASE_URL=sqlite:///dados/carteira.db

# Meu Pluggy (https://meu.pluggy.ai) - gratuito para uso pessoal, ate 5 conexoes
# Pegue Client ID e Client Secret no Dashboard depois de conectar suas contas.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# brapi.dev - cotacoes e proventos de acoes/FIIs da B3.
# O plano gratuito exige token desde 2024. Cadastro em https://brapi.dev/dashboard
BRAPI_TOKEN=

# Moeda base para consolidacao da carteira
INV_MOEDA_BASE=BRL
